# Copia este archivo como .env.local y rellena los valores.

# ── Base de datos ──────────────────────────────────────────────────────────
# Cadena con pooler para la aplicacion.
DATABASE_URL="postgresql://usuario:clave@host:6543/appweb?pgbouncer=true"
# Cadena directa, solo para migraciones.
DIRECT_URL="postgresql://usuario:clave@host:5432/appweb"

# ── Sesion ─────────────────────────────────────────────────────────────────
# Secreto para firmar el token. Genera uno con: openssl rand -base64 32
AUTH_SECRETO=""

# ── URLs publicas ──────────────────────────────────────────────────────────
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"

# ── Pago manual (activo) ───────────────────────────────────────────────────
# Datos que el checkout muestra como instrucciones de pago.
YAPE_NUMERO="999999999"
PLIN_NUMERO="999999999"
CUENTA_BANCARIA="123456789"
TITULAR_CUENTA="Nombre del titular"
# "si" muestra "Tarjeta (prueba)" en el checkout para ver pagos con tarjeta en
# el panel antes de la pasarela. No cobra nada y en produccion se ignora.
PAGO_TARJETA_PRUEBA="si"

# ── Correo (Resend) ────────────────────────────────────────────────────────
# Sin RESEND_API_KEY los correos NO se envian: se imprimen en la terminal de
# `npm run dev` (sirve para probar "recuperar clave" en local).
# La clave sale de https://resend.com/api-keys y el remitente tiene que ser de
# un dominio verificado en Resend.
RESEND_API_KEY=""
CORREO_REMITENTE="Tienda <pedidos@tudominio.pe>"
# A quien avisar cuando llega un pedido nuevo. Vacio = no se avisa por correo.
NOTIFICAR_PEDIDOS_A=""

# ── WhatsApp ───────────────────────────────────────────────────────────────
# Celular de la tienda (9 digitos). Activa el boton flotante de la tienda y
# "Enviar comprobante por WhatsApp" en el pedido. Vacio = sin botones.
WHATSAPP_TIENDA=""

# ── Pasarela de pago (F4, aun sin usar) ────────────────────────────────────
# La interfaz ya existe en packages/core/src/puertos/pasarela-pago.ts.
# Hasta que se integre, el checkout usa PagoManual (Yape, Plin, transferencia).
# IZIPAY_USUARIO=""
# IZIPAY_CLAVE=""

# ── Datos del proveedor (obligatorios para vender) ──────────────────────────
# Salen en el Libro de Reclamaciones, los terminos, la politica de privacidad
# y el pie de la tienda. Sin ellos esas paginas muestran "[configura ...]".
TIENDA_NOMBRE="SOCKS"
TIENDA_RAZON_SOCIAL="Tu Razón Social S.A.C."
TIENDA_RUC="20000000000"
TIENDA_DIRECCION="Av. Ejemplo 123, Ciudad"
# Atencion al cliente: recibe el aviso de cada reclamo nuevo y las consultas
# sobre datos personales. Vacio = el aviso de reclamos va a NOTIFICAR_PEDIDOS_A.
TIENDA_CORREO="atencion@tutienda.pe"

# ── Sesion compartida tienda / panel (produccion) ───────────────────────────
# Con la tienda en tutienda.pe y el panel en panel.tutienda.pe, la cookie tiene
# que ser del dominio padre o el panel no ve la sesion. En local, vacio.
COOKIE_DOMINIO=""

# WhatsApp para ventas al por mayor. Vacio = usa WHATSAPP_TIENDA.
WHATSAPP_MAYORISTA="999999999"

# ── Fotos de producto (Supabase Storage) ────────────────────────────────────
# Sin esto, en desarrollo las fotos se guardan en apps/web/public/subidas; en
# produccion la subida falla con un aviso. El bucket tiene que existir y ser
# PUBLICO (Supabase > Storage > New bucket > Public). La clave service_role
# sale de Project Settings > API y NUNCA va en una variable NEXT_PUBLIC_.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="productos"

// ═══════════════════════════════════════════════════════════════════════════
//  ESQUEMA — dieciocho tablas en ocho dominios:
//
//      Cuenta      usuarios, direcciones, niveles
//      Catalogo    categorias, marcas, productos, variantes, imagenes_producto
//      Contenido   banners
//      Stock       movimientos_stock
//      Venta       pedidos, items_pedido, pagos, historial_pedido
//      Promo/envio cupones, metodos_envio
//      Atencion    reclamos
//      Opinion     resenas
//
//  Diez son del arranque. Marca, Pago, HistorialPedido y Cupon se añadieron
//  porque guardan datos imposibles de reconstruir si llegan tarde (quien pago
//  con que operacion, quien cambio cada estado); Banner saca el contenido de
//  portada de Categoria. Reclamo es el Libro de Reclamaciones que la ley exige
//  desde la primera venta: una hoja que no se guardo el dia que llego no se
//  recupera despues. Resena es lo que opina quien compro: si no se le pregunta
//  cuando recibe el paquete, esa opinion no se recupera meses despues.
//  Nivel no guarda datos de clientes sino la regla del programa: sale del
//  codigo para que el panel ajuste montos y descuentos sin desplegar.
//
//  Orden de columnas dentro de cada modelo: identidad, contenido, relaciones,
//  montos o precio, SEO, estado, fechas. El orden fisico en la base es el de
//  las migraciones y no se toca: este archivo es el que se lee.
//
//  Se mantiene a mano. NO usar `prisma db pull`.
//
//  El criterio para añadir una tabla nueva no es "¿la necesito?", sino:
//      si la añado dentro de tres meses, ¿tendre los datos que necesita?
//  Si la respuesta es si, no hace falta ahora. Si es no, tiene que estar hoy.
//
//  Por eso estan desde el dia uno, aunque parezcan de mas:
//      · Variante separada de Producto  -> añadir tallas despues obliga a
//        migrar cada producto y cada pedido ya vendido.
//      · Precio congelado en ItemPedido -> si el precio se lee de la variante,
//        subir precios cambia el monto de todas las ventas pasadas.
//      · MovimientoStock                -> sin el, no se sabe por que falta
//        mercaderia, y el historico no se reconstruye.
//      · Direccion copiada en Pedido    -> si el cliente la edita, los pedidos
//        viejos dirian que se enviaron a la direccion nueva.
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: las cadenas de conexion ya no van aqui. Viven en
// packages/db/prisma.config.ts (migraciones) y en el cliente (aplicacion).
datasource db {
  provider = "postgresql"
}

// ═══ CUENTA ════════════════════════════════════════════════════════════════

enum Rol {
  CLIENTE
  VENDEDOR
  ALMACEN
  ADMIN
}

enum TipoDocumento {
  DNI
  RUC
  CARNE_EXTRANJERIA
  PASAPORTE
}

enum Genero {
  MASCULINO
  FEMENINO
  OTRO
  PREFIERO_NO_DECIR
}

model Usuario {
  // Acceso
  id    String @id @default(cuid())
  email String @unique
  clave String
  rol   Rol    @default(CLIENTE)
  // Persona
  nombre          String
  apellidoPaterno String?
  apellidoMaterno String?
  apodo           String?
  telefono        String?
  fechaNacimiento DateTime? @db.Date
  genero          Genero?
  // Documento (para el comprobante)
  tipoDocumento   TipoDocumento?
  numeroDocumento String?
  // Estado
  activo Boolean @default(true)
  // Fechas
  creadoEn       DateTime  @default(now())
  // Cambios del perfil. Iniciar sesion NO lo mueve (ver ingresar/acciones.ts).
  editadoEn      DateTime  @updatedAt
  // Ultimo inicio de sesion: seguridad y clientes inactivos. `null` = nunca
  // entro desde que existe la columna.
  ultimoAccesoEn DateTime?

  direcciones Direccion[]
  pedidos     Pedido[]
  // Auditoria: a quien se le atribuye cada pago confirmado, cada cambio de
  // estado y cada movimiento de stock. Quedan aunque el empleado cambie de rol.
  pagosConfirmados Pago[]            @relation("PagoConfirmadoPor")
  cambiosDePedido  HistorialPedido[] @relation("CambioHechoPor")
  movimientosStock MovimientoStock[] @relation("MovimientoHechoPor")
  reclamosRespondidos Reclamo[]      @relation("ReclamoRespondidoPor")
  resenasModeradas    Resena[]       @relation("ResenaModeradaPor")
  resenas             Resena[]       @relation("ResenaEscritaPor")

  @@index([rol])
  @@map("usuarios")
}

model Direccion {
  // Identidad
  id        String @id @default(cuid())
  usuarioId String
  // Quien recibe el paquete, que no siempre es el titular de la cuenta.
  destinatario String?
  telefono     String?
  // Ubicacion
  departamento String
  provincia    String
  distrito     String
  calle        String
  referencia   String?
  // Estado. Una sola principal por usuario: indice parcial en
  // prisma/sql/direccion-principal.sql.
  principal Boolean @default(false)
  // Fechas
  creadoEn  DateTime @default(now())
  editadoEn DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("direcciones")
}

// ═══ CATALOGO ══════════════════════════════════════════════════════════════

model Categoria {
  // Identidad
  id          String  @id @default(cuid())
  slug        String  @unique
  nombre      String
  // Contenido
  descripcion String?
  imagenUrl   String?
  // Arbol
  padreId     String?
  // SEO
  tituloSeo      String?
  descripcionSeo String?
  // Estado
  destacado Boolean @default(false)
  orden     Int     @default(0)
  activo    Boolean @default(true)
  // Fechas
  creadoEn  DateTime @default(now())
  editadoEn DateTime @updatedAt

  padre     Categoria?  @relation("Arbol", fields: [padreId], references: [id])
  hijas     Categoria[] @relation("Arbol")
  productos Producto[]

  @@index([padreId])
  // Menu de la cabecera: activas, de primer nivel, por orden.
  @@index([activo, padreId, orden])
  @@map("categorias")
}

// Marca como tabla: da pagina propia (logo, SEO), filtro por marca y evita que
// "Qiling" y "QILING" partan el catalogo en dos.
model Marca {
  // Identidad
  id          String  @id @default(cuid())
  slug        String  @unique
  nombre      String  @unique
  // Contenido
  descripcion String?
  logoUrl     String?
  // SEO
  tituloSeo      String?
  descripcionSeo String?
  // Estado
  destacado Boolean @default(false)
  orden     Int     @default(0)
  activo    Boolean @default(true)
  // Fechas
  creadoEn  DateTime @default(now())
  editadoEn DateTime @updatedAt

  productos Producto[]

  // Fila de marcas de la portada: activas, destacadas primero, por orden.
  @@index([activo, destacado, orden])
  @@map("marcas")
}

// El producto es la ficha que se ve; lo que se vende es la Variante.
model Producto {
  // Identidad
  id               String   @id @default(cuid())
  slug             String   @unique
  nombre           String
  // Contenido
  descripcion      String?
  // Resumen de una linea para la tarjeta del listado; `descripcion` es para
  // la ficha completa y no cabe ahi.
  descripcionCorta String?
  // Insignia corta sobre la imagen: "Nuevo", "Mas vendido". Texto libre.
  etiqueta         String?
  // Muestra "Envío gratis" sobre la foto de la tarjeta. Lo marca el panel a mano.
  envioGratis      Boolean  @default(false)
  // Datos tecnicos que no justifican columna: material, composicion, cuidado.
  // Ejemplo: { "material": "Algodon pima", "composicion": "85% algodon, 15% elastano" }
  specs            Json?
  // Relaciones
  categoriaId      String
  marcaId          String?
  // Precio, comun a todas las variantes. `precioLista` es el precio de antes:
  // mayor que `precio` cuando hay oferta (CHECK en prisma/sql/restricciones.sql).
  precio           Decimal  @db.Decimal(10, 2)
  precioLista      Decimal? @db.Decimal(10, 2)
  // SEO
  tituloSeo        String?
  descripcionSeo   String?
  // Estado. `destacado` = sale en "Productos destacados" de portada; no sirve
  // de nada si `activo` es false: un producto oculto no aparece en ningun lado.
  destacado        Boolean  @default(false)
  activo           Boolean  @default(true)
  // Fechas
  creadoEn         DateTime @default(now())
  editadoEn        DateTime @updatedAt

  categoria Categoria        @relation(fields: [categoriaId], references: [id])
  marca     Marca?           @relation(fields: [marcaId], references: [id])
  imagenes  ImagenProducto[]
  variantes Variante[]
  resenas   Resena[]

  // El indice que sostiene el listado de categoria de Clase A.
  @@index([categoriaId, activo])
  // Pagina de marca y filtro por marca.
  @@index([marcaId, activo])
  // "Productos nuevos" de la portada: activos, del mas reciente al mas viejo.
  @@index([activo, creadoEn])
  @@map("productos")
}

// Lo que se vende y se cuenta en almacen: un producto en una talla y un color.
model Variante {
  id         String  @id @default(cuid())
  productoId String
  // Talla y color son columnas, no un sistema generico de atributos. Para ropa
  // basica la dimension no cambia nunca, y esto ahorra cinco tablas y un join
  // en cada consulta del catalogo.
  talla      String
  color      String
  sku        String  @unique
  // Cache del saldo. La verdad es la suma de MovimientoStock; esta columna
  // existe solo para no sumar el historico en cada lectura del catalogo.
  stock      Int     @default(0)
  activo     Boolean @default(true)

  producto    Producto          @relation(fields: [productoId], references: [id], onDelete: Cascade)
  movimientos MovimientoStock[]
  itemsPedido ItemPedido[]

  @@unique([productoId, talla, color])
  @@index([productoId, activo])
  @@map("variantes")
}

model ImagenProducto {
  id         String @id @default(cuid())
  productoId String
  url        String
  alt        String?
  orden      Int    @default(0)

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([productoId, orden])
  @@map("imagenes_producto")
}

// ═══ CONTENIDO ═════════════════════════════════════════════════════════════

// Banners de la portada. Antes vivian como cinco columnas `portada*` dentro de
// Categoria, que es una tabla de catalogo. La portada los muestra todos los
// activos, por `orden`, en el carrusel superior (texto sobre tono pastel; la
// imagen no se usa hoy). El panel los edita en Ajustes.
model Banner {
  id        String   @id @default(cuid())
  etiqueta  String
  titulo    String
  texto     String
  imagenUrl String
  // Ruta interna a la que lleva el banner, p. ej. "/categorias/hombres".
  href      String
  // Texto del boton: "Ver ofertas", "Conocer envios".
  accion    String   @default("Ver más")
  orden     Int      @default(0)
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())
  editadoEn DateTime @updatedAt

  @@index([activo, orden])
  @@map("banners")
}

// ═══ STOCK ═════════════════════════════════════════════════════════════════

enum MotivoStock {
  INGRESO
  VENTA
  DEVOLUCION
  AJUSTE
  MERMA
}

model MovimientoStock {
  id         String      @id @default(cuid())
  varianteId String
  // Positivo suma, negativo resta. Nunca se actualiza: se escribe uno nuevo.
  delta      Int
  motivo     MotivoStock
  pedidoId   String?
  // Quien registro el movimiento (ingreso, ajuste, merma). `null` = el sistema,
  // por ejemplo al descontar una venta.
  usuarioId  String?
  nota       String?
  creadoEn   DateTime    @default(now())

  variante Variante @relation(fields: [varianteId], references: [id])
  pedido   Pedido?  @relation(fields: [pedidoId], references: [id])
  usuario  Usuario? @relation("MovimientoHechoPor", fields: [usuarioId], references: [id])

  @@index([varianteId, creadoEn])
  @@index([pedidoId])
  @@map("movimientos_stock")
}

// ═══ VENTA ═════════════════════════════════════════════════════════════════

enum EstadoPedido {
  PENDIENTE_PAGO
  PAGADO
  PREPARANDO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum TipoComprobante {
  BOLETA
  FACTURA
}

enum MedioPago {
  YAPE
  PLIN
  TRANSFERENCIA
  CONTRA_ENTREGA
}

model Pedido {
  // Identidad
  id        String       @id @default(cuid())
  codigo    String       @unique
  usuarioId String
  estado    EstadoPedido @default(PENDIENTE_PAGO)

  // Montos
  subtotal    Decimal @db.Decimal(10, 2)
  descuento   Decimal @default(0) @db.Decimal(10, 2)
  costoEnvio  Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)
  // Codigo del cupon aplicado, congelado: si la campana cambia o se borra, la
  // venta sigue diciendo con que codigo se desconto.
  cuponCodigo String?

  // Pago. Elegido en el checkout; `PasarelaPago` lo necesita para recalcular
  // las instrucciones de pago sin volver a preguntar. Los cobros reales van en
  // la tabla `pagos`.
  medioPago MedioPago

  // Envio. Direccion COPIADA, no referenciada: si el cliente edita su
  // direccion, este pedido tiene que seguir diciendo a donde se envio de verdad.
  envioDestinatario String?
  envioTelefono     String?
  envioDepartamento String
  envioProvincia    String
  envioDistrito     String
  envioCalle        String
  envioReferencia   String?
  envioMetodo       String

  // Seguimiento del paquete. Se llenan al despachar y al entregar.
  transportista     String?
  codigoSeguimiento String?
  enviadoEn         DateTime?
  entregadoEn       DateTime?

  // Comprobante. Se pide en el checkout DESDE AHORA aunque la boleta se emita
  // fuera del sistema (la facturacion electronica es una fase posterior): si
  // no se capturan al inicio, el dia que toque emitir no hay forma de
  // conseguirlos.
  comprobante TipoComprobante @default(BOLETA)
  documento   String
  razonSocial String?

  // Fechas
  creadoEn  DateTime @default(now())
  editadoEn DateTime @updatedAt

  usuario     Usuario           @relation(fields: [usuarioId], references: [id])
  items       ItemPedido[]
  pagos       Pago[]
  historial   HistorialPedido[]
  movimientos MovimientoStock[]

  @@index([usuarioId, creadoEn])
  @@index([estado, creadoEn])
  @@map("pedidos")
}

model ItemPedido {
  id         String @id @default(cuid())
  pedidoId   String
  varianteId String

  // Congelados en el momento de la compra. La referencia a Variante queda
  // para trazar, pero lo que se factura y se muestra sale de estas columnas.
  nombreProducto String
  sku            String
  talla          String
  color          String
  precioUnitario Decimal @db.Decimal(10, 2)
  cantidad       Int

  pedido   Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  variante Variante @relation(fields: [varianteId], references: [id])

  @@index([pedidoId])
  // "Mas vendidos" y el historial de ventas de una variante.
  @@index([varianteId])
  @@map("items_pedido")
}

enum EstadoPago {
  PENDIENTE
  CONFIRMADO
  RECHAZADO
  REEMBOLSADO
}

// Un pedido puede tener varios pagos: un intento rechazado y otro confirmado,
// o un reembolso. `Pedido.estado` dice donde va el pedido; esta tabla dice que
// plata entro, con que numero de operacion y quien la confirmo.
model Pago {
  id              String     @id @default(cuid())
  pedidoId        String
  medio           MedioPago
  monto           Decimal    @db.Decimal(10, 2)
  estado          EstadoPago @default(PENDIENTE)
  // Numero de operacion de Yape, Plin o la transferencia.
  referencia      String?
  // Captura o voucher que sube el cliente.
  comprobanteUrl  String?
  confirmadoPorId String?
  confirmadoEn    DateTime?
  creadoEn        DateTime   @default(now())

  pedido        Pedido   @relation(fields: [pedidoId], references: [id])
  confirmadoPor Usuario? @relation("PagoConfirmadoPor", fields: [confirmadoPorId], references: [id])

  // El mismo numero de operacion no puede cobrar dos pedidos. Los NULL no
  // chocan entre si, asi que contra entrega queda libre.
  @@unique([medio, referencia])
  @@index([pedidoId])
  @@index([estado, creadoEn])
  @@map("pagos")
}

// Cada cambio de estado de un pedido, con quien lo hizo y cuando. Solo se
// agrega, nunca se edita: es lo que responde "¿quien lo marco enviado?".
model HistorialPedido {
  id             String        @id @default(cuid())
  pedidoId       String
  estadoAnterior EstadoPedido?
  estadoNuevo    EstadoPedido
  // `null` = lo hizo el sistema (por ejemplo, al crear el pedido).
  usuarioId      String?
  nota           String?
  creadoEn       DateTime      @default(now())

  pedido  Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation("CambioHechoPor", fields: [usuarioId], references: [id])

  @@index([pedidoId, creadoEn])
  @@map("historial_pedido")
}

// ═══ PROMO Y ENVIO ═════════════════════════════════════════════════════════

// Cupones de descuento. `Pedido.cuponCodigo` guarda el codigo usado; esta
// tabla guarda las reglas vigentes.
model Cupon {
  id           String    @id @default(cuid())
  codigo       String    @unique
  // Porcentaje del subtotal, de 1 a 100 (CHECK en prisma/sql/restricciones.sql).
  porcentaje   Int
  minimoCompra Decimal?  @db.Decimal(10, 2)
  // `null` = sin tope de usos.
  usosMaximos  Int?
  usos         Int       @default(0)
  desde        DateTime?
  hasta        DateTime?
  activo       Boolean   @default(true)
  creadoEn     DateTime  @default(now())
  editadoEn    DateTime  @updatedAt

  @@map("cupones")
}

// Niveles de recompensa (Básico, Bronce, Plata, Oro, Platino). Son cinco
// filas fijas: el panel edita monto, pedidos y descuento de cada uno, pero no
// crea ni borra niveles. El nivel de cada cliente no se guarda: se calcula con
// sus pedidos contra estas filas (`nivelPorCompras` de @appweb/core).
model Nivel {
  // "BASICO" | "BRONCE" | "PLATA" | "ORO" | "PLATINO"
  id             String   @id
  nombre         String
  // Desde cuanto comprado (S/) se alcanza. Básico siempre en 0; cada nivel
  // por encima del anterior (lo valida `revisarNiveles` de @appweb/core).
  desde          Decimal  @db.Decimal(10, 2)
  // Pedidos que hacen falta ademas del monto: una sola compra grande no basta.
  pedidosMinimos Int      @default(0)
  // Descuento automatico en cada compra, de 0 a 100. No se suma al cupon.
  descuentoPct   Int
  // Lo que ve el cliente en "Mi cuenta": el descuento y el obsequio.
  beneficio      String
  orden          Int
  editadoEn      DateTime @updatedAt

  @@map("niveles")
}

model MetodoEnvio {
  id          String   @id @default(cuid())
  nombre      String
  costo       Decimal  @db.Decimal(10, 2)
  // Desde este subtotal el envio sale gratis. `null` = nunca.
  gratisDesde Decimal? @db.Decimal(10, 2)
  // Departamentos a los que llega. Vacio = todo el pais. La regla vive en
  // `cubreDepartamento` de @appweb/core: "Lima y Callao" no cobra S/ 12 por
  // enviar a Cusco.
  departamentos String[] @default([])
  activo      Boolean  @default(true)
  orden       Int      @default(0)
  creadoEn    DateTime @default(now())
  editadoEn   DateTime @updatedAt

  @@map("metodos_envio")
}

// ═══ ATENCION ══════════════════════════════════════════════════════════════

enum TipoReclamo {
  RECLAMO
  QUEJA
}

enum TipoBien {
  PRODUCTO
  SERVICIO
}

enum EstadoReclamo {
  PENDIENTE
  RESPONDIDO
}

// Hoja del Libro de Reclamaciones virtual. Se conserva al menos dos años y
// nunca se borra ni se edita: el consumidor recibe su copia por correo y lo
// que dice la base tiene que coincidir con esa copia. Los datos del
// consumidor van COPIADOS (puede reclamar sin cuenta) y la respuesta se
// escribe una sola vez. Plazo y numero de hoja: `@appweb/core` (reclamos/).
model Reclamo {
  // Identidad. `numero` es el correlativo que exige la norma.
  id     String      @id @default(cuid())
  numero Int         @unique @default(autoincrement())
  tipo   TipoReclamo

  // Consumidor
  nombre          String
  tipoDocumento   TipoDocumento
  numeroDocumento String
  domicilio       String
  telefono        String
  email           String
  // Menor de edad: la hoja va a nombre de su padre, madre o apoderado.
  menorDeEdad     Boolean       @default(false)
  apoderado       String?

  // Bien contratado
  tipoBien        TipoBien
  pedidoCodigo    String?
  monto           Decimal? @db.Decimal(10, 2)
  descripcionBien String

  // Reclamo
  detalle String
  pedido  String

  // Respuesta del proveedor
  estado          EstadoReclamo @default(PENDIENTE)
  respuesta       String?
  respondidoPorId String?
  respondidoEn    DateTime?

  // Fechas
  creadoEn DateTime @default(now())

  respondidoPor Usuario? @relation("ReclamoRespondidoPor", fields: [respondidoPorId], references: [id])

  @@index([estado, creadoEn])
  @@map("reclamos")
}

// ═══ OPINION ═══════════════════════════════════════════════════════════════

enum EstadoResena {
  PENDIENTE
  APROBADA
  RECHAZADA
}

// Opinion de un cliente sobre un producto que recibio. Una por cliente y
// producto; se ve en la tienda solo despues de que el panel la aprueba. Quien
// puede escribirla y como se resume la nota: `@appweb/core` (resenas/).
model Resena {
  // Identidad
  id         String @id @default(cuid())
  productoId String
  usuarioId  String
  // Contenido. Estrellas de 1 a 5 (CHECK en prisma/sql/restricciones.sql).
  estrellas  Int
  comentario String?
  // Moderacion
  estado        EstadoResena @default(PENDIENTE)
  moderadoPorId String?
  moderadoEn    DateTime?
  // Fechas
  creadoEn  DateTime @default(now())
  editadoEn DateTime @updatedAt

  producto    Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  usuario     Usuario  @relation("ResenaEscritaPor", fields: [usuarioId], references: [id])
  moderadoPor Usuario? @relation("ResenaModeradaPor", fields: [moderadoPorId], references: [id])

  @@unique([usuarioId, productoId])
  // Opiniones publicadas de una ficha, de la mas nueva a la mas vieja.
  @@index([productoId, estado, creadoEn])
  // Cola de moderacion del panel.
  @@index([estado, creadoEn])
  @@map("resenas")
}
